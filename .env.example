# --- Email (Gmail SMTP via nodemailer) ---
# 1. Activez la validation en 2 etapes sur votre compte Gmail
# 2. Creez un mot de passe d'application (16 caracteres) :
#    https://myaccount.google.com/apppasswords
# 3. SMTP_PASS = ce mot de passe de 16 caracteres (PAS votre mdp Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=groupedentalimport@gmail.com
SMTP_PASS=votre_mot_de_passe_16_caracteres
EMAIL_FROM=OUADAH DENTAL GROUPE <groupedentalimport@gmail.com>
EMAIL_TO=groupedentalimport@gmail.com

# Get a free API key at https://resend.com (3000 emails/month free).
# Calls the Resend REST API directly via fetch — no SDK installed.
#
# IMPORTANT (dev mode):
#   Until you verify your own domain in Resend, you MUST keep EMAIL_FROM
#   as "OUADAH DENTAL GROUPE <onboarding@resend.dev>". The Resend test
#   domain can ONLY deliver to the email address associated with your
#   Resend account — admin notifications to other addresses will be
#   rejected with a 403. Verify your domain and update EMAIL_FROM to
#   "OUADAH DENTAL GROUPE <contact@your-domain.dz>" to send to anyone.
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=OUADAH DENTAL GROUPE <onboarding@resend.dev>
# Where admin notifications are sent (your business inbox):
EMAIL_TO=contact@odg-dz.com

# --- Cron job secret ---
# Protects the /api/cron/reminders endpoint. Set a random string.
# Used by cron-job.org to call the endpoint daily.
# Generate one with: openssl rand -hex 32
CRON_SECRET=your-random-secret-here

# --- Email logging (optional — Tier 3, Task EMAIL-V3) ---
# Every email sent through src/lib/email.ts is recorded in the
# `email_log` Supabase table for audit + debug. If the table does
# not exist, logging silently no-ops (no error, no broken sends).
#
# To enable: run this SQL in the Supabase Dashboard → SQL Editor:
#
#   CREATE TABLE IF NOT EXISTS email_log (
#     id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
#     to_email text NOT NULL,
#     subject text,
#     template text,             -- which template function was used
#     status text DEFAULT 'sent', -- 'sent' | 'failed' | 'skipped'
#     error text,
#     message_id text,
#     created_at timestamptz DEFAULT now()
#   );
#   CREATE INDEX IF NOT EXISTS email_log_created_at_idx
#     ON email_log (created_at DESC);
#
# No env var needed — the service-role client (SUPABASE_SERVICE_ROLE_KEY
# above) is reused. The schema is documented inline at the top of
# src/lib/email-log.ts.
