# ============================================================
# OUADAH DENTAL GROUPE — Variables d'environnement
# ============================================================
# Copiez ce fichier en .env et remplissez les valeurs.
# Sur Vercel : Dashboard → Settings → Environment Variables.

# --- Supabase (obligatoire) ---
NEXT_PUBLIC_SUPABASE_URL=https://qhxbucaofjsigxwgmjdi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_ici

# Service role key — SERVER SIDE ONLY (jamais exposée côté client).
# Nécessaire pour /api/contact, /api/newsletter, /api/admin/*.
# Dashboard Supabase → Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_ici

# --- Admin (obligatoire pour l'accès admin) ---
# Mot de passe de connexion à /#/admin
# ⚠️ CHANGEZ CE MOT DE PASSE après la première connexion !
ADMIN_PASSWORD=votre_mot_de_passe_admin

# Secret aléatoire pour signer le cookie de session admin.
# Générez une chaîne aléatoire longue, ex: `openssl rand -hex 32`
ADMIN_SECRET=remplacez_par_une_chaine_aleatoire_longue

# --- Chatbot IA (Google Gemini) ---
# Gratuit : https://aistudio.google.com/apikey
# Modele : gemini-2.0-flash (rapide, multilingue FR/AR)
GEMINI_API_KEY=votre_cle_gemini

# --- Email (Gmail SMTP via nodemailer) ---
# 1. Activez la validation en 2 etapes sur votre compte Gmail
# 2. Creez un mot de passe d'application (16 caracteres) :
#    https://myaccount.google.com/apppasswords
# 3. SMTP_PASS = ce mot de passe de 16 caracteres (PAS votre mdp Gmail)
# --- Email (SMTP via nodemailer) ---
# Gmail: activez la validation en 2 étapes + mot de passe d'application
# Autre provider: adaptez SMTP_HOST/SMTP_PORT
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_PASS=votre_mot_de_passe_16_caracteres

# Expéditeur affiché dans les emails (nom <email>)
EMAIL_FROM=OUADAH DENTAL GROUPE <contact@odg-dz.com>

# Destinataire des notifications admin (formulaire de contact, etc.)
EMAIL_TO=contact@odg-dz.com

# --- Resend (optionnel, alternative à SMTP) ---
# Clé API Resend (3000 emails/mois gratuits)
# RESEND_API_KEY=re_your_api_key_here

# --- Cron job secret ---
# Protects the /api/cron/reminders endpoint. Set a random string.
# Used by cron-job.org to call the endpoint daily.
# Generate one with: openssl rand -hex 32
CRON_SECRET=your-random-secret-here

# --- Email logging (optional — Tier 3, Task EMAIL-V3) ---
# Every email sent through src/lib/email.ts is recorded in the
# `email_log` Supabase table for audit + debug. If the table does
# not exist, logging silently no-ops (no error, no broken sends).
#
# To enable: run this SQL in the Supabase Dashboard → SQL Editor:
#
#   CREATE TABLE IF NOT EXISTS email_log (
#     id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
#     to_email text NOT NULL,
#     subject text,
#     template text,             -- which template function was used
#     status text DEFAULT 'sent', -- 'sent' | 'failed' | 'skipped'
#     error text,
#     message_id text,
#     created_at timestamptz DEFAULT now()
#   );
#   CREATE INDEX IF NOT EXISTS email_log_created_at_idx
#     ON email_log (created_at DESC);
#
# No env var needed — the service-role client (SUPABASE_SERVICE_ROLE_KEY
# above) is reused. The schema is documented inline at the top of
# src/lib/email-log.ts.
